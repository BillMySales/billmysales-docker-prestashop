# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8102.
PS_URL=http://localhost:8102
SITE_ADDRESS=:80
HTTP_PORT=8102
HTTPS_PORT=8402
MAILPIT_PORT=8025

# Back office: http://localhost:8102/admin-dev/
PS_FOLDER_ADMIN=admin-dev
PS_DEV_MODE=0

# Show PHP errors in the browser (never in production).
PHP_DISPLAY_ERRORS=On

# Dev-only credentials.
DB_PASSWORD=prestashop
DB_ROOT_PASSWORD=root
PS_ADMIN_EMAIL=admin@example.com
PS_ADMIN_PASSWORD=admin12345

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/module.yaml
#MODULE_PATH=../billmysales-plugin-prestashop
#MODULE_NAME=billmysales

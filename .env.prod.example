# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=prestashop

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the shop (domain and SSL are applied on every `up`).
PS_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Credentials and back office (REQUIRED)
# ---------------------------------------------------------------------------
# Use long random values: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
# PS_ADMIN_* are only used by the installer: changing them later in .env
# doesn't change the account (do it in the back office).
PS_ADMIN_EMAIL=
PS_ADMIN_PASSWORD=
# Back office directory name: keep it hard to guess, e.g. admin-$(openssl rand -hex 4)
PS_FOLDER_ADMIN=
#PS_ADMIN_FIRSTNAME=Admin
#PS_ADMIN_LASTNAME=Shop
#DB_NAME=prestashop
#DB_USER=prestashop

# ---------------------------------------------------------------------------
# Shop (used by the installer, only on the first install)
# ---------------------------------------------------------------------------
#PS_SHOP_NAME=PrestaShop
#PS_LANGUAGE=es
#PS_COUNTRY=cl
#PS_TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# PrestaShop Classic distribution (https://github.com/PrestaShopCorp/prestashop-classic)
# and its zip's SHA-256 (empty = don't verify). Only used when the ps_data
# volume is created; afterwards PrestaShop is upgraded from the back office.
#PS_VERSION=9.1.5-5.0
#PS_SHA256=37140cb77c03acf61b832f76893cd8fe1e304b0fc14fa5485cfea4a7bfaf3a72
#PHP_VERSION=8.5
# Image name for the built PrestaShop image.
#PS_IMAGE=prestashop-fpm
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#MAILPIT_VERSION=v1.31
# Mailpit web UI port (development only, profile "mailpit").
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# PrestaShop / PHP
# ---------------------------------------------------------------------------
# Debug mode: never in production.
#PS_DEV_MODE=0
#PHP_MEMORY_LIMIT=512M
# Show PHP errors in the browser: Off in production (errors go to the logs).
#PHP_DISPLAY_ERRORS=Off
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# PHP-FPM pool. Rough sizing: max_children = RAM for PHP / ~100 MB per worker.
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500

# ---------------------------------------------------------------------------
# Mail (SMTP), recommended: without SMTP_HOST no emails are sent (the image
# has no local mail server). When SMTP_HOST is set, these values replace the
# SMTP settings of the back office on every `up`.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS) or none (no encryption).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Shop email address (sender of the shop's emails).
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#PS_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
